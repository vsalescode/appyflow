generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String            @id @default(uuid()) @db.Uuid
  installationKey  String            @default("primary") @map("installation_key") @db.VarChar(32)
  email            String            @unique @db.VarChar(320)
  displayName      String?           @map("display_name") @db.VarChar(120)
  passwordHash     String            @map("password_hash") @db.Text
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions         Session[]
  resumes          Resume[]
  candidateProfile CandidateProfile?

  @@unique([installationKey], map: "users_installation_key_key")
  @@map("users")
}

model Resume {
  id            String             @id @default(uuid()) @db.Uuid
  userId        String             @map("user_id") @db.Uuid
  originalName  String             @map("original_name") @db.VarChar(255)
  mediaType     String             @map("media_type") @db.VarChar(100)
  sizeBytes     Int                @map("size_bytes")
  checksum      String             @db.Char(64)
  storageKey    String             @unique @map("storage_key") @db.VarChar(255)
  extractedText String             @map("extracted_text") @db.Text
  pageCount     Int                @map("page_count")
  isActive      Boolean            @default(true) @map("is_active")
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  facts         ProfessionalFact[]

  @@index([userId, createdAt])
  @@map("resumes")
}

enum Seniority {
  UNSPECIFIED
  INTERN
  JUNIOR
  MID_LEVEL
  SENIOR
  LEAD
  MANAGER
  EXECUTIVE
}

enum ProfessionalFactType {
  SKILL
  EXPERIENCE
}

enum FactReviewStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum WorkMode {
  REMOTE
  HYBRID
  ONSITE
}

enum SearchQueryOrigin {
  DETERMINISTIC
  AI
}

enum WorkArrangement {
  UNKNOWN
  REMOTE
  HYBRID
  ONSITE
}

enum SourceKind {
  UNKNOWN
  ATS
  CAREER_PAGE
  AGGREGATOR
  SPECIALIZED_PORTAL
}

enum MatchClassification {
  HOT
  WARM
  COLD
}

enum ApplicationStatus {
  FOUND
  INTERESTING
  RESUME_PREPARED
  APPLIED
  INTERVIEW
  OFFER
  REJECTED
  ARCHIVED
}

enum ResumeLanguage {
  PT_BR
  EN
}

enum SearchRunStatus {
  RUNNING
  COMPLETED
  PARTIAL_FAILURE
  FAILED
}

model CandidateProfile {
  id                String             @id @default(uuid()) @db.Uuid
  userId            String             @unique @map("user_id") @db.Uuid
  headline          String?            @db.VarChar(160)
  summary           String?            @db.Text
  seniority         Seniority          @default(UNSPECIFIED)
  city              String?            @db.VarChar(120)
  region            String?            @db.VarChar(120)
  country           String?            @db.VarChar(2)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  professionalFacts ProfessionalFact[]
  preference        Preference?
  searchQueries     SearchQuery[]
  jobs              Job[]
  searchSchedule    SearchSchedule?
  searchRuns        SearchRun[]

  @@map("candidate_profiles")
}

model SearchSchedule {
  id              String           @id @default(uuid()) @db.Uuid
  profileId       String           @unique @map("profile_id") @db.Uuid
  enabled         Boolean          @default(false)
  scheduledTime   String           @default("09:00") @map("scheduled_time") @db.Char(5)
  timeZone        String           @default("UTC") @map("time_zone") @db.VarChar(100)
  maxQueries      Int              @default(10) @map("max_queries")
  resultsPerQuery Int              @default(10) @map("results_per_query")
  nextRunAt       DateTime?        @map("next_run_at") @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  profile         CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([enabled, nextRunAt])
  @@map("search_schedules")
}

model SearchRun {
  id               String           @id @default(uuid()) @db.Uuid
  profileId        String           @map("profile_id") @db.Uuid
  status           SearchRunStatus
  startedAt        DateTime         @map("started_at") @db.Timestamptz(3)
  finishedAt       DateTime?        @map("finished_at") @db.Timestamptz(3)
  queriesTotal     Int              @default(0) @map("queries_total")
  queriesSucceeded Int              @default(0) @map("queries_succeeded")
  queriesFailed    Int              @default(0) @map("queries_failed")
  resultsFound     Int              @default(0) @map("results_found")
  resultsStored    Int              @default(0) @map("results_stored")
  resultsRejected  Int              @default(0) @map("results_rejected")
  jobsMatched      Int              @default(0) @map("jobs_matched")
  jobsSkipped      Int              @default(0) @map("jobs_skipped")
  failures         Json?
  profile          CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, startedAt])
  @@index([status, startedAt])
  @@map("search_runs")
}

model SearchQuery {
  id          String            @id @default(uuid()) @db.Uuid
  profileId   String            @map("profile_id") @db.Uuid
  query       String            @db.VarChar(300)
  normalized  String            @db.VarChar(300)
  origin      SearchQueryOrigin
  aiModel     String?           @map("ai_model") @db.VarChar(160)
  aiRequestId String?           @map("ai_request_id") @db.VarChar(255)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  profile     CandidateProfile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  occurrences JobOccurrence[]

  @@unique([profileId, normalized])
  @@index([profileId, createdAt])
  @@map("search_queries")
}

model Source {
  id              String                 @id @default(uuid()) @db.Uuid
  provider        String                 @db.VarChar(50)
  domain          String                 @db.VarChar(253)
  kind            SourceKind             @default(UNKNOWN)
  firstSeenAt     DateTime               @default(now()) @map("first_seen_at") @db.Timestamptz(3)
  lastSeenAt      DateTime               @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  occurrenceCount Int                    @default(0) @map("occurrence_count")
  uniqueJobCount  Int                    @default(0) @map("unique_job_count")
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  occurrences     JobOccurrence[]
  metricHistory   SourceMetricSnapshot[]

  @@unique([provider, domain])
  @@map("sources")
}

model SourceMetricSnapshot {
  id              String   @id @default(uuid()) @db.Uuid
  sourceId        String   @map("source_id") @db.Uuid
  occurrenceCount Int      @map("occurrence_count")
  uniqueJobCount  Int      @map("unique_job_count")
  observedAt      DateTime @map("observed_at") @db.Timestamptz(3)
  source          Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId, observedAt])
  @@map("source_metric_snapshots")
}

model Job {
  id              String           @id @default(uuid()) @db.Uuid
  profileId       String           @map("profile_id") @db.Uuid
  fingerprint     String           @db.Char(64)
  title           String           @db.VarChar(300)
  company         String?          @db.VarChar(200)
  description     String?          @db.Text
  location        String?          @db.VarChar(200)
  workArrangement WorkArrangement  @default(UNKNOWN) @map("work_arrangement")
  publishedAt     DateTime?        @map("published_at") @db.Timestamptz(3)
  discoveredAt    DateTime         @default(now()) @map("discovered_at") @db.Timestamptz(3)
  profile         CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  occurrences     JobOccurrence[]
  match           JobMatch?
  application     Application?

  @@unique([profileId, fingerprint])
  @@index([profileId, discoveredAt])
  @@map("jobs")
}

model Application {
  id             String                   @id @default(uuid()) @db.Uuid
  jobId          String                   @unique @map("job_id") @db.Uuid
  status         ApplicationStatus        @default(FOUND)
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  job            Job                      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  history        ApplicationStatusEvent[]
  preparation    ApplicationPreparation?
  resumeVersions ResumeVersion[]

  @@index([status, updatedAt])
  @@map("applications")
}

model ResumeVersion {
  id               String         @id @default(uuid()) @db.Uuid
  applicationId    String         @map("application_id") @db.Uuid
  language         ResumeLanguage
  content          Json
  templateKey      String         @map("template_key") @db.VarChar(80)
  templateChecksum String         @map("template_checksum") @db.Char(64)
  texStorageKey    String         @unique @map("tex_storage_key") @db.VarChar(255)
  texFileName      String         @map("tex_file_name") @db.VarChar(255)
  pdfStorageKey    String         @unique @map("pdf_storage_key") @db.VarChar(255)
  pdfFileName      String         @map("pdf_file_name") @db.VarChar(255)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  application      Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
  @@map("resume_versions")
}

model ApplicationPreparation {
  id            String         @id @default(uuid()) @db.Uuid
  applicationId String         @unique @map("application_id") @db.Uuid
  language      ResumeLanguage
  content       Json
  aiModel       String         @map("ai_model") @db.VarChar(160)
  aiRequestId   String?        @map("ai_request_id") @db.VarChar(255)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  application   Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("application_preparations")
}

model ApplicationStatusEvent {
  id            String            @id @default(uuid()) @db.Uuid
  applicationId String            @map("application_id") @db.Uuid
  fromStatus    ApplicationStatus @map("from_status")
  toStatus      ApplicationStatus @map("to_status")
  changedAt     DateTime          @map("changed_at") @db.Timestamptz(3)
  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, changedAt])
  @@map("application_status_events")
}

model JobMatch {
  id              String              @id @default(uuid()) @db.Uuid
  jobId           String              @unique @map("job_id") @db.Uuid
  score           Int
  classification  MatchClassification
  evaluatedWeight Int                 @map("evaluated_weight")
  matchedSkills   String[]            @default([]) @map("matched_skills")
  breakdown       Json
  reasons         String[]            @default([])
  calculatedAt    DateTime            @map("calculated_at") @db.Timestamptz(3)
  aiAnalysis      Json?               @map("ai_analysis")
  aiModel         String?             @map("ai_model") @db.VarChar(160)
  aiRequestId     String?             @map("ai_request_id") @db.VarChar(255)
  aiAnalyzedAt    DateTime?           @map("ai_analyzed_at") @db.Timestamptz(3)
  job             Job                 @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([classification, score])
  @@map("job_matches")
}

model JobOccurrence {
  id             String      @id @default(uuid()) @db.Uuid
  jobId          String      @map("job_id") @db.Uuid
  searchQueryId  String      @map("search_query_id") @db.Uuid
  sourceId       String      @map("source_id") @db.Uuid
  originalUrl    String      @map("original_url") @db.VarChar(2048)
  canonicalUrl   String      @map("canonical_url") @db.VarChar(2048)
  publishedLabel String?     @map("published_label") @db.VarChar(100)
  discoveredAt   DateTime    @default(now()) @map("discovered_at") @db.Timestamptz(3)
  job            Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  searchQuery    SearchQuery @relation(fields: [searchQueryId], references: [id], onDelete: Cascade)
  source         Source      @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@unique([searchQueryId, sourceId, canonicalUrl])
  @@index([jobId])
  @@index([sourceId])
  @@map("job_occurrences")
}

model Preference {
  id                String           @id @default(uuid()) @db.Uuid
  profileId         String           @unique @map("profile_id") @db.Uuid
  desiredRoles      String[]         @default([]) @map("desired_roles")
  seniorities       Seniority[]      @default([])
  workModes         WorkMode[]       @default([]) @map("work_modes")
  locations         String[]         @default([])
  languages         String[]         @default([])
  technologies      String[]         @default([])
  salaryMinimum     Decimal?         @map("salary_minimum") @db.Decimal(12, 2)
  salaryCurrency    String?          @map("salary_currency") @db.Char(3)
  excludedCompanies String[]         @default([]) @map("excluded_companies")
  excludedKeywords  String[]         @default([]) @map("excluded_keywords")
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  profile           CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("preferences")
}

model ProfessionalFact {
  id             String               @id @default(uuid()) @db.Uuid
  profileId      String               @map("profile_id") @db.Uuid
  type           ProfessionalFactType
  title          String               @db.VarChar(160)
  organization   String?              @db.VarChar(160)
  description    String?              @db.Text
  startedAt      DateTime?            @map("started_at") @db.Date
  endedAt        DateTime?            @map("ended_at") @db.Date
  sourceResumeId String?              @map("source_resume_id") @db.Uuid
  reviewStatus   FactReviewStatus     @default(CONFIRMED) @map("review_status")
  evidenceQuote  String?              @map("evidence_quote") @db.Text
  aiModel        String?              @map("ai_model") @db.VarChar(160)
  aiRequestId    String?              @map("ai_request_id") @db.VarChar(255)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  profile        CandidateProfile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  sourceResume   Resume?              @relation(fields: [sourceResumeId], references: [id], onDelete: Cascade)

  @@index([profileId, type])
  @@index([sourceResumeId])
  @@map("professional_facts")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}
